# ===========================================
# VARIÁVEIS DE AMBIENTE - SOUNDX QUALITY
# ===========================================

# Porta do Servidor (padrão: 3001)
PORT=3001

# Banco de Dados PostgreSQL (Supabase ou Local)
# Se não configurado, o sistema usa automaticamente o fallback local (local_data.json)
DATABASE_URL=postgresql://postgres:sua_senha@seu_host.supabase.co:5432/postgres?sslmode=require

# Chave secreta JWT (gere uma segura em produção)
JWT_SECRET=soundx_secret_key_2026

# URL do Frontend (para controle de CORS)
FRONTEND_URL=http://localhost:3001

# Ambiente: development ou production
NODE_ENV=development
