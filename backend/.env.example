# ===========================================
# VARIÁVEIS DE AMBIENTE - VERCEL (BACKEND)
# ===========================================
# Copie cada valor para: Vercel → Settings → Environment Variables
# NÃO commite este arquivo com valores reais!

# -------------------------------------------
# BANCO DE DADOS (Supabase)
# -------------------------------------------
# Pegue em: Supabase → Settings → Database → Connection Pooling
# Formato: postgresql://postgres:[SENHA]@[HOST]:5432/[DB]?sslmode=require
DATABASE_URL=postgresql://postgres:password@host.supabase.co:5432/database?sslmode=require

# -------------------------------------------
# JWT SECRET (gere um seguro!)
# -------------------------------------------
# No terminal: openssl rand -base64 32
# Exemplo: k3ySup3rS3cr3t0L0ng0ParaJWT2026!@#
JWT_SECRET=gere_um_com_openssl_rand_base64_32

# -------------------------------------------
# FRONTEND URL (para CORS)
# -------------------------------------------
# Coloque a URL exata do Netlify DEPOIS do deploy
# Exemplo: https://soundx-quality.netlify.app
FRONTEND_URL=https://SEU-SITE.netlify.app

# -------------------------------------------
# AMBIENTE
# -------------------------------------------
NODE_ENV=production